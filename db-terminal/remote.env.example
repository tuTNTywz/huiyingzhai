# 汇英斋数据库终端 —— Windows 远程服务器配置模板
# 复制为 remote.env 后填写；remote.env 已被 .gitignore 忽略，不会被提交。

# 服务器地址：可以是 IP、域名，或 ~/.ssh/config 里的 Host 别名
HOST=your-server.example.com
# SSH 登录用户：通常是 root 或 ubuntu
USER=ubuntu
PORT=22

# SSH 私钥路径（推荐）。留空则使用 ssh 默认密钥或交互输入密码。
# 注意：图形界面无法输入密码，必须使用密钥（或 ssh-agent）。
# SSH_KEY=C:\Users\你的用户名\.ssh\id_ed25519
# 额外 ssh 参数，例如首次连接自动接受服务器指纹：
# SSH_OPTIONS=-o StrictHostKeyChecking=accept-new
# 可选：自定义 ssh / scp 可执行文件（一般不用填）
# SSH_BIN=
# SCP_BIN=

# 服务端目录（server/deploy/install.sh 的默认位置）
SERVER_ROOT=/opt/huiyingzhai/server

# 以哪个用户身份执行数据库操作。
# install.sh 创建的服务用户是 huiyingzhai；留空表示直接用 SSH 用户执行。
SUDO_USER=huiyingzhai

# 服务器上的 Python 解释器（终端只用标准库，不需要虚拟环境）
PYTHON=python3

# dbterm.py 上传到服务器的位置。/tmp 重启后可能被清空，
# 下次运行会自动重新上传。
REMOTE_SCRIPT=/tmp/huiyingzhai-dbterm.py

# 远程 backup / export 的默认目录，避免备份写进 /tmp。
# 留空则与 REMOTE_SCRIPT 同目录（不推荐）。
REMOTE_HOME=/opt/huiyingzhai/.dbterm
