# 复制为 .env 后按需修改：cp .env.example .env
# 服务端口（Nginx 反向代理到这里）
PORT=3000

# 对外 HTTPS 地址，无末尾斜杠。必须与微信公众平台配置的服务器域名一致
BASE_URL=https://api.example.com

# 微信小程序凭据（公众平台 - 开发管理 - 开发设置）
# 两项都填好后会自动关闭开发模式
WX_APPID=
WX_SECRET=

# 本地调试设为 true：不请求微信服务器，所有登录使用 DEV_OPENID
# 生产环境必须留空，否则所有用户会被识别成同一账号
DEV_MODE=
DEV_OPENID=dev-openid-1

# 登录有效期（天）
SESSION_DAYS=30

# 订阅消息：模板 ID 必须与 miniprogram/config.js 中一致
WX_TMPL_HOMEWORK=6avlHCT0IR-fd1hk3c15hQDn0X0VWmuQs0rcdbN5FgM
# developer（开发版）/ trial（体验版）/ formal（正式版）
WX_PUSH_STATE=trial

# 单个附件上限（MB），与前端 20MB 限制保持一致
MAX_UPLOAD_MB=20

# 网页数据上传页与小程序的内部共享密钥（install.sh 自动生成，请勿外传）
WEB_PANEL_SECRET=

# 可选：班级通知机器人，两种渠道任选或同时启用（留空不发送）
# A. PushPlus 群组（推荐，不需要安装企业微信）
#    官网登录 → 发送消息 → 一对多消息 → 新建群组，取得 token 与群组编码
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
# QQ 群通知（第三方 PushPlus 渠道，可选）
# PushPlus 个人中心 → 渠道配置 → QQ机器人，绑定并建群配置后填写配置编码
PUSHPLUS_QQ_OPTION=

# QQ 官方机器人（QQ 开放平台 q.qq.com，推荐，不经过第三方）
# 回调地址：https://<域名>/api/qq/webhook
QQ_APP_ID=
QQ_APP_SECRET=
# 开放平台「开发设置」里的 Bot Secret，用于 Webhook Ed25519 验签
QQ_BOT_SECRET=
# 可选：群 openid。留空时由机器人入群/群消息事件自动记录到 data/qq_group.json
QQ_GROUP_OPENID=
# B. 企业微信群机器人（群成员需在企业微信）
#    企业微信群 → 右上角「…」→ 群机器人 → 添加 → 复制 Webhook 地址
WECHAT_ROBOT_WEBHOOK=

# 可选：自定义数据与附件目录。默认 server/data、server/uploads
# 生产环境建议放到 /var/lib/huiyingzhai 并赋予服务用户写权限
# DATA_DIR=/var/lib/huiyingzhai/data
# UPLOAD_DIR=/var/lib/huiyingzhai/uploads
