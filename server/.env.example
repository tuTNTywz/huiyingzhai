# 复制为 .env 后按需修改：cp .env.example .env
# 服务端口（Nginx 反向代理到这里）
PORT=3000

# 对外 HTTPS 地址，无末尾斜杠
BASE_URL=https://api.example.com

# 登录有效期（天）
SESSION_DAYS=30

# 单个附件上限（MB），与前端 20MB 限制保持一致
MAX_UPLOAD_MB=20

# 网页面板与后端的内部共享密钥（install.sh 自动生成，请勿外传）
WEB_PANEL_SECRET=

# 可选：班级通知机器人，两种渠道任选或同时启用（留空不发送）
# A. PushPlus 群组
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
# QQ 群通知（第三方 PushPlus 渠道，可选）
PUSHPLUS_QQ_OPTION=

# QQ 官方机器人（QQ 开放平台 q.qq.com）
# 回调地址：https://<域名>/api/qq/webhook
QQ_APP_ID=
QQ_APP_SECRET=
# 开放平台「开发设置」里的 Bot Secret，用于 Webhook Ed25519 验签
QQ_BOT_SECRET=
# 可选：群 openid。留空时由机器人入群/群消息事件自动记录到 data/qq_group.json
QQ_GROUP_OPENID=

# 企业微信群机器人（群成员需在企业微信，可选）
WECHAT_ROBOT_WEBHOOK=

# 可选：自定义数据与附件目录。默认 server/data、server/uploads
# 生产环境建议放到 /var/lib/huiyingzhai 并赋予服务用户写权限
# DATA_DIR=/var/lib/huiyingzhai/data
# UPLOAD_DIR=/var/lib/huiyingzhai/uploads
