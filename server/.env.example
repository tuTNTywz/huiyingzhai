# 复制为 .env 后按需修改：cp .env.example .env
# 服务端口（Nginx 反向代理到这里）
PORT=3000

# 对外 HTTPS 地址，无末尾斜杠。必须与微信公众平台配置的服务器域名一致
BASE_URL=https://api.example.com

# 微信小程序凭据（公众平台 - 开发管理 - 开发设置）
# 两项都填好后会自动关闭开发模式
WX_APPID=
WX_SECRET=

# 本地调试设为 true：不请求微信服务器，所有登录使用 DEV_OPENID
# 生产环境必须留空，否则所有用户会被识别成同一账号
DEV_MODE=
DEV_OPENID=dev-openid-1

# 登录有效期（天）
SESSION_DAYS=30

# 订阅消息：模板 ID 必须与 miniprogram/config.js 中一致
WX_TMPL_HOMEWORK=6avlHCT0IR-fd1hk3c15hQDn0X0VWmuQs0rcdbN5FgM
# developer（开发版）/ trial（体验版）/ formal（正式版）
WX_PUSH_STATE=trial

# 单个附件上限（MB），与前端 20MB 限制保持一致
MAX_UPLOAD_MB=20

# 可选：自定义数据与附件目录。默认 server/data、server/uploads
# 生产环境建议放到 /var/lib/huiyingzhai 并赋予服务用户写权限
# DATA_DIR=/var/lib/huiyingzhai/data
# UPLOAD_DIR=/var/lib/huiyingzhai/uploads
