# /etc/huiyingzhai/panel.env
# 由 systemd 以 root 读取后传给面板进程；权限保持 600。
# 账号保存在 PANEL_ACCOUNTS_FILE，密码只存 PBKDF2 哈希。
PANEL_PORT=3999
PANEL_QUEUE_DIR=/var/lib/huiyingzhai-panel
PANEL_ACCOUNTS_FILE=/var/lib/huiyingzhai-panel/accounts.json

# root 部署脚本写入、面板只读的状态/日志
PANEL_STATUS_FILE=/var/lib/huiyingzhai-deploy/status.json
PANEL_CURRENT_FILE=/var/lib/huiyingzhai-deploy/current.json
PANEL_LOG_FILE=/var/log/huiyingzhai-deploy.log
