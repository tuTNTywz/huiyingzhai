[Unit]
Description=Huiyingzhai mini program API
After=network.target

[Service]
Type=simple
User=huiyingzhai
Group=huiyingzhai
WorkingDirectory=/opt/huiyingzhai/server
EnvironmentFile=/opt/huiyingzhai/server/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/huiyingzhai/server/.venv/bin/python -m app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
