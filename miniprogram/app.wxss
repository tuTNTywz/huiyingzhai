/* 汇英斋 · 简约古风 全局样式 */
page {
  background: #f5f1e8;
  color: #3d3a34;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 卡片 */
.card {
  background: #fdfbf6;
  border: 1rpx solid #e4dccb;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 24rpx 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(120, 100, 70, 0.06);
}

/* 标题 */
.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #3d3a34;
}

.subtitle {
  font-size: 24rpx;
  color: #8a8478;
}

/* 赭石色主按钮 */
.btn-primary {
  background: #9c6b4a;
  color: #fdfbf6;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.btn-primary::after { border: none; }

.btn-plain {
  background: transparent;
  color: #9c6b4a;
  border: 1rpx solid #9c6b4a;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.btn-plain::after { border: none; }

.btn-disabled {
  background: #cfc7b6;
  color: #fdfbf6;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.btn-disabled::after { border: none; }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.tag-gold { background: #f0e6d2; color: #9c6b4a; }
.tag-green { background: #e6ece2; color: #6b7d5f; }
.tag-red { background: #f3e3dd; color: #b5543c; }
.tag-gray { background: #ebe7de; color: #8a8478; }

/* 分隔 */
.divider {
  height: 1rpx;
  background: #e4dccb;
  margin: 24rpx 0;
}

/* 列表项 */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid #eee8da;
}
.cell:last-child { border-bottom: none; }

/* 空状态 */
.empty {
  text-align: center;
  color: #b0a894;
  padding: 100rpx 0;
  font-size: 26rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 32rpx;
}
.form-label {
  font-size: 28rpx;
  color: #6f6858;
  margin-bottom: 14rpx;
}
.form-input {
  background: #fdfbf6;
  border: 1rpx solid #e4dccb;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}
.form-textarea {
  background: #fdfbf6;
  border: 1rpx solid #e4dccb;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  width: auto;
  height: 180rpx;
}
.picker-value {
  background: #fdfbf6;
  border: 1rpx solid #e4dccb;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #3d3a34;
}
.picker-placeholder { color: #b0a894; }
