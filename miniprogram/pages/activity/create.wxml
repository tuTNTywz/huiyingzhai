<view class="card">
  <view class="form-item">
    <view class="form-label">活动名称</view>
    <input class="form-input" placeholder="如：春日雅集 · 诗会" value="{{title}}" bindinput="onTitle" />
  </view>

  <view class="form-item">
    <view class="form-label">活动时间</view>
    <view class="picker-row">
      <picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="onDate">
        <view class="picker-value {{date ? '' : 'picker-placeholder'}}">{{date || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{time}}" bindchange="onTime">
        <view class="picker-value">{{time}}</view>
      </picker>
    </view>
  </view>

  <view class="form-item">
    <view class="form-label">活动地点</view>
    <input class="form-input" placeholder="如：教学楼 305" value="{{place}}" bindinput="onPlace" />
  </view>

  <view class="form-item">
    <view class="form-label">活动说明（选填）</view>
    <textarea class="form-textarea" placeholder="简述活动安排与注意事项…" value="{{content}}" bindinput="onContent" maxlength="500" />
  </view>

  <button
    class="{{submitting ? 'btn-disabled' : 'btn-primary'}}"
    disabled="{{submitting}}"
    bindtap="submit"
  >发 布 活 动</button>
</view>
