.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.detail-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.info-row {
  display: flex;
  font-size: 28rpx;
  color: #4a463e;
  margin-bottom: 16rpx;
}
.info-label {
  color: #8a8478;
  margin-right: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #9c6b4a;
  margin-bottom: 12rpx;
}
.detail-desc {
  font-size: 28rpx;
  color: #4a463e;
  white-space: pre-wrap;
}
.del-btn {
  margin-top: 40rpx;
}
