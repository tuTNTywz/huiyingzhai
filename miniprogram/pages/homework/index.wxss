.page-header {
  padding: 40rpx 32rpx 8rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.page-sub {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 8rpx;
}

.section-head {
  font-size: 30rpx;
  font-weight: bold;
  color: #9c6b4a;
  margin: 32rpx 32rpx 4rpx;
}
.class-hw-head {
  margin-top: 40rpx;
}
.subject-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}
.subject-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 12rpx;
}
.subject-inner {
  background: #fdfbf6;
  border: 1rpx solid #e4dccb;
  border-radius: 16rpx;
  padding: 22rpx;
  min-height: 140rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 100, 70, 0.06);
}
.subject-cell:active .subject-inner {
  background: #f2e9d8;
}
.subject-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.subject-ordinal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e8dcc6;
  color: #9c6b4a;
  font-size: 26rpx;
}
.subject-arrow {
  font-size: 22rpx;
  color: #b0a894;
}
.subject-name {
  font-size: 27rpx;
  font-weight: bold;
  color: #3d3a34;
  margin-top: 16rpx;
  line-height: 1.45;
}

.create-btn {
  margin: 24rpx 24rpx 0;
  text-align: center;
}

.hw-item:active {
  background: #f6f0e2;
}
.hw-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hw-title {
  flex: 1;
  margin-right: 16rpx;
}
.hw-desc {
  font-size: 26rpx;
  color: #6f6858;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.hw-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}
