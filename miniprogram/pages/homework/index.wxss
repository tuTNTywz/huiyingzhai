.page-header {
  padding: 40rpx 32rpx 8rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.page-sub {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 8rpx;
}

.create-btn {
  margin: 24rpx 24rpx 0;
  text-align: center;
}

.hw-item:active {
  background: #f6f0e2;
}

.hw-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hw-title {
  flex: 1;
  margin-right: 16rpx;
}
.hw-desc {
  font-size: 26rpx;
  color: #6f6858;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.hw-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}
