.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.detail-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.detail-creator {
  margin-top: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #9c6b4a;
  margin-bottom: 12rpx;
}
.detail-desc {
  font-size: 28rpx;
  color: #4a463e;
  white-space: pre-wrap;
}
.file-row:active {
  background: #f6f0e2;
}
.file-name {
  flex: 1;
  font-size: 27rpx;
  color: #4a463e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.file-action {
  font-size: 26rpx;
  color: #9c6b4a;
}
