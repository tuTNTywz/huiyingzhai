<view class="page-header">
  <view class="page-title">作业簿</view>
  <view class="page-sub">「 业精于勤，荒于嬉 」</view>
</view>

<block wx:if="{{isCommittee}}">
  <view class="btn-primary create-btn" bindtap="goCreate">＋ 发布作业</view>
</block>

<view wx:if="{{!loading && list.length === 0}}" class="empty">
  暂无作业，静候先生布置
</view>

<view
  class="card hw-item"
  wx:for="{{list}}"
  wx:key="_id"
  data-id="{{item._id}}"
  bindtap="goDetail"
  bindlongpress="onDelete"
>
  <view class="hw-top">
    <view class="title hw-title">{{item.title}}</view>
    <text class="tag {{item.expired ? 'tag-gray' : 'tag-green'}}">
      {{item.expired ? '已截止' : '进行中'}}
    </text>
  </view>
  <view class="hw-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
  <view class="hw-meta">
    <text class="subtitle">截止：{{item.deadlineText}}</text>
    <text class="subtitle" wx:if="{{item.attachments.length}}">📎 {{item.attachments.length}} 份附件</text>
  </view>
  <view class="hw-meta">
    <text class="subtitle">布置人：{{item.creatorName}}</text>
  </view>
</view>
