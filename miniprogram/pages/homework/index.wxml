<view class="page-header">
  <view class="page-title">作业簿</view>
  <view class="page-sub">「 业精于勤，荒于嬉 」</view>
</view>

<view class="section-head">学科板块</view>
<view class="subject-grid">
  <view
    class="subject-cell"
    wx:for="{{subjects}}"
    wx:key="key"
    data-key="{{item.key}}"
    bindtap="goSubject"
  >
    <view class="subject-inner">
      <view class="subject-top">
        <view class="subject-ordinal">{{item.ordinal}}</view>
        <view class="subject-arrow">进入 ›</view>
      </view>
      <view class="subject-name">{{item.name}}</view>
    </view>
  </view>
</view>

<view class="section-head class-hw-head">班级作业</view>
<block wx:if="{{isCommittee}}">
  <view class="btn-primary create-btn" bindtap="goCreate">＋ 发布作业</view>
</block>

<view wx:if="{{!loading && list.length === 0}}" class="empty">
  暂无班级作业，静候先生布置
</view>

<view
  class="card hw-item"
  wx:for="{{list}}"
  wx:key="_id"
  data-id="{{item._id}}"
  bindtap="goDetail"
  bindlongpress="onDelete"
>
  <view class="hw-top">
    <view class="title hw-title">{{item.title}}</view>
    <text class="tag {{item.expired ? 'tag-gray' : 'tag-green'}}">
      {{item.expired ? '已截止' : '进行中'}}
    </text>
  </view>
  <view class="hw-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
  <view class="hw-meta">
    <text class="subtitle">截止：{{item.deadlineText}}</text>
    <text class="subtitle" wx:if="{{item.attachments.length}}">📎 {{item.attachments.length}} 份附件</text>
  </view>
  <view class="hw-meta">
    <text class="subtitle">布置人：{{item.creatorName}}</text>
  </view>
</view>
