.reg-header {
  text-align: center;
  padding: 60rpx 0 30rpx;
}
.reg-seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid #9c6b4a;
  border-radius: 12rpx;
  background: #9c6b4a;
  color: #fdfbf6;
  font-size: 48rpx;
  letter-spacing: 2rpx;
}
.reg-title {
  font-size: 42rpx;
  font-weight: bold;
  letter-spacing: 6rpx;
  margin-top: 24rpx;
}
.reg-sub {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 8rpx;
}
.position-tip {
  font-size: 22rpx;
  color: #8a8478;
  margin-top: 14rpx;
  line-height: 1.5;
}
