<view class="page-header">
  <view class="page-title">交流</view>
  <view class="page-sub">「 奇文共欣赏，疑义相与析 」</view>
</view>

<view class="card compose-card">
  <view class="compose-hint">{{nickname}}，说点什么吧</view>
  <textarea
    class="compose-input"
    placeholder="畅所欲言，与同窗交流…"
    value="{{content}}"
    bindinput="onInput"
    maxlength="1000"
  />

  <view class="attach-actions">
    <view class="btn-plain attach-btn" bindtap="chooseFile">＋ 文件</view>
    <view class="btn-plain attach-btn" bindtap="chooseImage">＋ 照片</view>
  </view>
  <view class="form-tip">文件从微信聊天记录选择（PDF / Word / Excel / PPT / TXT）；照片可从相册或拍照添加，最多 5 个、单个不超过 20MB</view>

  <view class="file-item" wx:for="{{attachments}}" wx:key="tempPath">
    <view class="file-name">{{item.type === 'image' ? '🖼' : '📄'}} {{item.name}}
      <text class="file-size">{{item.sizeText}}</text>
    </view>
    <view class="file-del" data-index="{{index}}" catchtap="removeFile">移除</view>
  </view>
  <view wx:if="{{uploadText}}" class="upload-hint">{{uploadText}}</view>

  <button
    class="{{publishing ? 'btn-disabled' : 'btn-primary'}} compose-btn"
    disabled="{{publishing}}"
    bindtap="publish"
  >{{publishing ? '发布中…' : '发 帖'}}</button>
</view>

<view wx:if="{{!loading && list.length === 0}}" class="empty">还没有帖子，来开个话题吧</view>

<view
  class="card post-item"
  wx:for="{{list}}"
  wx:key="_id"
  data-id="{{item._id}}"
  bindtap="goDetail"
  bindlongpress="onDelete"
>
  <view class="post-head">
    <view class="post-author">
      <text class="avatar">{{item.avatarText}}</text>
      <text>{{item.nickname}}</text>
      <text class="tag {{item.isCommittee ? 'tag-gold' : 'tag-green'}}">{{item.isCommittee ? '班委' : '同学'}}</text>
    </view>
    <text class="subtitle">{{item.timeText}}</text>
  </view>
  <view wx:if="{{item.content}}" class="post-content">{{item.content}}</view>

  <view wx:if="{{item.attachments.length}}" class="attach-list" catchtap="noop">
    <view class="attach-summary">📎 {{item.attachments.length}} 个附件（点击查看）</view>
    <view
      class="attach-row"
      wx:for="{{item.attachments}}"
      wx:for-item="att"
      wx:key="fileID"
      data-fileid="{{att.fileID}}"
      data-name="{{att.name}}"
      data-type="{{att.type}}"
      catchtap="openAttachment"
    >
      <text class="attach-name">{{att.type === 'image' ? '🖼' : '📄'}} {{att.name}}</text>
      <text class="attach-size">{{att.sizeText}}</text>
    </view>
  </view>

  <view class="subtitle post-foot">💬 {{item.replyCount || 0}} 条回复</view>
</view>
