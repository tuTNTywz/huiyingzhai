.detail-page {
  padding-bottom: 130rpx;
}
.post-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.post-author {
  display: flex;
  align-items: center;
  font-size: 27rpx;
}
.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8dcc6;
  color: #9c6b4a;
  font-size: 26rpx;
  margin-right: 14rpx;
}
.post-content {
  font-size: 29rpx;
  color: #3d3a34;
  margin-top: 20rpx;
  white-space: pre-wrap;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #9c6b4a;
  margin-bottom: 10rpx;
}
.reply-item {
  border-bottom: 1rpx solid #eee8da;
  padding: 22rpx 0;
}
.reply-item:last-child {
  border-bottom: none;
}
.reply-content {
  font-size: 27rpx;
  color: #4a463e;
  padding: 10rpx 0 0 66rpx;
  white-space: pre-wrap;
}
.empty-sm {
  text-align: center;
  color: #b0a894;
  font-size: 26rpx;
  padding: 30rpx 0;
}

.reply-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fdfbf6;
  border-top: 1rpx solid #e4dccb;
}
.reply-input {
  flex: 1;
  background: #f5f1e8;
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  font-size: 27rpx;
}
.reply-send {
  background: #9c6b4a;
  color: #fdfbf6;
  border-radius: 32rpx;
  padding: 14rpx 32rpx;
  font-size: 27rpx;
}
.reply-send.sending {
  background: #cfc7b6;
}
