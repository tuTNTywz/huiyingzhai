<view class="detail-page" wx:if="{{post}}">
  <view class="card">
    <view class="post-head">
      <view class="post-author">
        <text class="avatar">{{post.avatarText}}</text>
        <text>{{post.nickname}}</text>
        <text class="tag {{post.isCommittee ? 'tag-gold' : 'tag-green'}}">{{post.isCommittee ? '班委' : '同学'}}</text>
      </view>
      <text class="subtitle">{{post.timeText}}</text>
    </view>
    <view class="post-content">{{post.content}}</view>
  </view>

  <view class="card">
    <view class="section-title">共 {{replies.length}} 条回复</view>
    <view wx:if="{{replies.length === 0}}" class="empty-sm">还没有回复，来抢个先</view>
    <view class="reply-item" wx:for="{{replies}}" wx:key="_id">
      <view class="post-head">
        <view class="post-author">
          <text class="avatar">{{item.avatarText}}</text>
          <text>{{item.nickname}}</text>
        </view>
        <text class="subtitle">{{item.timeText}}</text>
      </view>
      <view class="reply-content">{{item.content}}</view>
    </view>
  </view>
</view>

<view class="reply-bar">
  <input
    class="reply-input"
    placeholder="回复 {{nickname}}…"
    value="{{content}}"
    bindinput="onInput"
    confirm-type="send"
    bindconfirm="sendReply"
    maxlength="500"
  />
  <view class="reply-send {{sending ? 'sending' : ''}}" bindtap="sendReply">发送</view>
</view>
