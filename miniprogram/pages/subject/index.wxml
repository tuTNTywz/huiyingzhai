<view class="board-header">
  <view class="board-ordinal">{{ordinal}}</view>
  <view class="board-name">{{subjectName}}</view>
  <view class="board-sub">「 课业所在，各有专司 」</view>
  <view class="board-rep">
    <text class="tag tag-gold">课代表</text>
    <text class="subtitle">{{fallbackRep}}</text>
  </view>
</view>

<!-- 课程设置 -->
<view class="card settings-card">
  <view class="section-title">课程设置</view>
  <view class="cell"><view class="cell-label">任课老师</view><view class="cell-value">{{settings.teacher || '待设置'}}</view></view>
  <view class="cell"><view class="cell-label">学　　分</view><view class="cell-value">{{creditText}}</view></view>
  <view class="cell"><view class="cell-label">课程安排</view><view class="cell-value">{{settings.schedule || '待设置'}}</view></view>
  <view class="cell"><view class="cell-label">课　代表</view><view class="cell-value">{{fallbackRep}}</view></view>
  <button wx:if="{{isMonitor}}" class="btn-plain setting-btn" bindtap="openSettings">编辑课程设置（管理员）</button>
</view>

<view wx:if="{{canManage}}" class="btn-primary publish-btn" bindtap="openPublish">＋ 发布任务通知</view>

<view wx:if="{{!loading && list.length === 0}}" class="empty">本科目暂无任务通知</view>

<view
  class="card task-item"
  wx:for="{{list}}"
  wx:key="_id"
  data-id="{{item._id}}"
  bindtap="toggleExpand"
  bindlongpress="onDelete"
>
  <view class="task-top">
    <view class="title">{{item.title}}</view>
    <text wx:if="{{item.deadlineText}}" class="tag {{item.expired ? 'tag-gray' : 'tag-green'}}">
      {{item.expired ? '已截止' : '进行中'}}
    </text>
    <text wx:else class="tag tag-gold">通知</text>
  </view>

  <view class="task-content {{expandedId === item._id ? 'expanded' : ''}}">{{item.content || '（无详细内容）'}}</view>

  <!-- 任务通知附件 -->
  <view wx:if="{{item.attachments.length}}" class="task-attach" catchtap="noop">
    <view class="attach-summary">📎 附件 {{item.attachments.length}} 个（点击查看）</view>
    <view
      class="attach-row-item"
      wx:for="{{item.attachments}}"
      wx:for-item="att"
      wx:key="fileID"
      data-fileid="{{att.fileID}}"
      data-name="{{att.name}}"
      data-type="{{att.type}}"
      catchtap="downloadAttachment"
    >
      <text class="attach-name">{{att.type === 'image' ? '🖼' : '📄'}} {{att.name}}</text>
      <text class="attach-size">{{att.sizeText}}</text>
    </view>
  </view>

  <view class="task-meta">
    <text class="subtitle" wx:if="{{item.deadlineText}}">截止：{{item.deadlineText}}</text>
    <text class="subtitle">发布：{{item.creatorName}} · {{item.createTimeText}}</text>
  </view>
  <view class="task-toggle">{{expandedId === item._id ? '收起 ▲' : '展开全文 ▼'}}</view>
</view>

<!-- 课程设置编辑窗口（管理员） -->
<view class="modal-mask" wx:if="{{showSettings}}" bindtap="closeSettings">
  <view class="modal-card" catchtap="noop">
    <view class="modal-title">课程设置</view>
    <view class="modal-sub">{{subjectName}} · 仅管理员可编辑</view>

    <view class="form-item">
      <view class="form-label">任课老师</view>
      <input class="form-input" placeholder="填写任课老师姓名" value="{{settingsForm.teacher}}" data-field="teacher" bindinput="onSettingsField" maxlength="20" />
    </view>

    <view class="form-item">
      <view class="form-label">学分</view>
      <input class="form-input" type="digit" placeholder="如：3.0" value="{{settingsForm.credit}}" data-field="credit" bindinput="onSettingsField" maxlength="6" />
    </view>

    <view class="form-item">
      <view class="form-label">课程安排</view>
      <textarea class="form-textarea" placeholder="如：周一 3-4 节 · 教三 201" value="{{settingsForm.schedule}}" data-field="schedule" bindinput="onSettingsField" maxlength="200" />
    </view>

    <view class="position-tip">课代表由班级名单（数据库 roster 集合）指定，如需调整请联系管理员修改名单</view>

    <view class="modal-actions">
      <button class="btn-plain" bindtap="closeSettings">取 消</button>
      <button class="{{savingSettings ? 'btn-disabled' : 'btn-primary'}}" disabled="{{savingSettings}}" bindtap="saveSettings">{{savingSettings ? '保存中…' : '保 存'}}</button>
    </view>
  </view>
</view>

<!-- 发布任务通知弹窗 -->
<view class="modal-mask" wx:if="{{showPublish}}" bindtap="closePublish">
  <view class="modal-card" catchtap="noop">
    <view class="modal-title">发布任务通知</view>
    <view class="modal-sub">{{subjectName}} · 课代表发布</view>

    <view class="form-item">
      <view class="form-label">标题</view>
      <input class="form-input" placeholder="如：第三单元作业提交提醒" value="{{form.title}}" data-field="title" bindinput="onField" maxlength="50" />
    </view>

    <view class="form-item">
      <view class="form-label">通知内容</view>
      <textarea class="form-textarea" placeholder="填写任务要求、提交方式等…" value="{{form.content}}" data-field="content" bindinput="onField" maxlength="500" />
    </view>

    <view class="form-item">
      <view class="form-label">截止时间（选填）</view>
      <view class="picker-row">
        <picker mode="date" value="{{form.date}}" start="{{minDate}}" bindchange="onDate">
          <view class="picker-value {{form.date ? '' : 'picker-placeholder'}}">{{form.date || '不设截止'}}</view>
        </picker>
        <picker mode="time" value="{{form.time}}" bindchange="onTime">
          <view class="picker-value">{{form.time}}</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">附件（最多 5 个，单个不超过 20MB）</view>
      <view class="attach-actions">
        <view class="btn-plain attach-btn" catchtap="chooseTaskFile">＋ 文件</view>
        <view class="btn-plain attach-btn" catchtap="chooseTaskImage">＋ 照片</view>
      </view>
      <view class="position-tip">文件从微信聊天记录选择（PDF / Word / Excel / PPT / TXT）；照片可从相册或拍照添加</view>

      <view class="file-item" wx:for="{{taskAttachments}}" wx:key="tempPath">
        <view class="file-name">{{item.type === 'image' ? '🖼' : '📄'}} {{item.name}}
          <text class="file-size">{{item.sizeText}}</text>
        </view>
        <view class="file-del" data-index="{{index}}" catchtap="removeTaskFile">移除</view>
      </view>
      <view wx:if="{{uploadText}}" class="upload-hint">{{uploadText}}</view>
    </view>

    <view class="modal-actions">
      <button class="btn-plain" bindtap="closePublish">取 消</button>
      <button class="{{submitting ? 'btn-disabled' : 'btn-primary'}}" disabled="{{submitting}}" bindtap="publish">{{submitting ? '发 布 中…' : '发 布'}}</button>
    </view>
  </view>
</view>
