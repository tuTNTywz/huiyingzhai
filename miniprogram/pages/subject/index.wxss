.board-header {
  text-align: center;
  padding: 40rpx 32rpx 20rpx;
}
.board-ordinal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid #9c6b4a;
  border-radius: 50%;
  background: #e8dcc6;
  color: #9c6b4a;
  font-size: 34rpx;
}
.board-name {
  font-size: 42rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-top: 18rpx;
}
.board-sub {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 6rpx;
}
.board-rep {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #9c6b4a;
  margin-bottom: 6rpx;
}
.cell-label {
  font-size: 27rpx;
  color: #6f6858;
  white-space: nowrap;
}
.cell-value {
  font-size: 27rpx;
  color: #3d3a34;
  text-align: right;
  margin-left: 24rpx;
}
.setting-btn {
  margin-top: 28rpx;
}

.publish-btn {
  margin: 16rpx 24rpx 0;
  text-align: center;
}

.task-item:active {
  background: #f6f0e2;
}
.task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.task-content {
  font-size: 27rpx;
  color: #4a463e;
  margin: 16rpx 0;
  white-space: pre-wrap;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.task-content.expanded {
  -webkit-line-clamp: unset;
  display: block;
}
.task-meta {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid #eee8da;
  padding-top: 14rpx;
}
.task-toggle {
  text-align: right;
  font-size: 23rpx;
  color: #9c6b4a;
  margin-top: 10rpx;
}

/* 任务通知附件 */
.task-attach {
  background: #f6f1e4;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-top: 14rpx;
}
.attach-summary {
  font-size: 24rpx;
  color: #6f6858;
  margin-bottom: 8rpx;
}
.attach-row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  border-top: 1rpx solid #e8e0cd;
}
.attach-name {
  flex: 1;
  font-size: 25rpx;
  color: #4a463e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.attach-size {
  font-size: 22rpx;
  color: #a49a86;
  margin-left: 12rpx;
}

/* 发布弹窗中的附件选择 */
.attach-actions {
  display: flex;
  gap: 16rpx;
}
.attach-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f6f1e4;
}
.file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f6f1e4;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-top: 12rpx;
}
.file-name {
  flex: 1;
  font-size: 25rpx;
  color: #6f6858;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.file-size {
  font-size: 22rpx;
  color: #a49a86;
  margin-left: 12rpx;
}
.file-del {
  font-size: 24rpx;
  color: #b5543c;
  padding-left: 20rpx;
}
.upload-hint {
  font-size: 24rpx;
  color: #9c6b4a;
  margin-top: 14rpx;
}

.picker-row {
  display: flex;
  gap: 16rpx;
}
.picker-row picker {
  flex: 1;
}
.position-tip {
  font-size: 22rpx;
  color: #8a8478;
  margin-top: 12rpx;
  line-height: 1.5;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(61, 58, 52, 0.48);
}
.modal-card {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  background: #fdfbf6;
  border: 1rpx solid #e4dccb;
  border-radius: 20rpx;
  padding: 36rpx 30rpx 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(60, 45, 25, 0.18);
}
.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.modal-sub {
  font-size: 23rpx;
  color: #8a8478;
  margin: 6rpx 0 30rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}
.modal-actions button {
  flex: 1;
}
