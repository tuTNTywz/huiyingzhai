.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.detail-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.detail-creator {
  margin-top: 12rpx;
}

.sign-btn {
  margin-top: 40rpx;
}

.signed-box {
  margin-top: 36rpx;
  text-align: center;
  background: #eef2e9;
  border-radius: 12rpx;
  padding: 30rpx;
  color: #6b7d5f;
}
.signed-icon {
  font-size: 48rpx;
  font-weight: bold;
  color: #6b7d5f;
}

.info-row {
  display: flex;
  font-size: 28rpx;
  color: #4a463e;
  margin-bottom: 16rpx;
}
.info-label {
  color: #8a8478;
  margin-right: 24rpx;
  white-space: nowrap;
}
.activity-content {
  font-size: 28rpx;
  color: #4a463e;
  white-space: pre-wrap;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #9c6b4a;
  margin-bottom: 10rpx;
}
.record-row:active {
  background: #f6f0e2;
}
.record-name {
  font-size: 28rpx;
}
.empty-sm {
  text-align: center;
  color: #b0a894;
  font-size: 26rpx;
  padding: 30rpx 0;
}
