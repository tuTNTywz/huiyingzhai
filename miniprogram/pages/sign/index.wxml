<view class="page-header">
  <view class="page-title">志愿活动</view>
  <view class="page-sub">「 赠人玫瑰，手有余香 」</view>
</view>

<block wx:if="{{canCreate}}">
  <view class="btn-primary create-btn" bindtap="goCreate">＋ 发布志愿活动</view>
</block>

<view wx:if="{{!loading && list.length === 0}}" class="empty">暂无志愿活动</view>

<view
  class="card sign-item"
  wx:for="{{list}}"
  wx:key="_id"
  data-id="{{item._id}}"
  bindtap="goDetail"
>
  <view class="sign-top">
    <view class="title">{{item.title}}</view>
    <text class="tag {{item.status === 'active' ? 'tag-green' : item.status === 'pending' ? 'tag-gold' : 'tag-gray'}}">
      {{item.status === 'active' ? '进行中' : item.status === 'pending' ? '未开始' : '已结束'}}
    </text>
  </view>
  <view wx:if="{{item.activityText}}" class="subtitle sign-meta">活动时间：{{item.activityText}}</view>
  <view wx:if="{{item.place}}" class="subtitle sign-meta">活动地点：{{item.place}}</view>
  <view class="subtitle sign-meta">报名方式：{{item.signupMethod}}</view>
  <view class="subtitle sign-meta">报名截止：{{item.endText}}</view>
  <view class="subtitle">发起人：{{item.creatorName}}</view>
</view>
