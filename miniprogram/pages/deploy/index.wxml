<view class="deploy-page">
  <view class="card">
    <view class="deploy-head">
      <view class="deploy-badge {{statusClass}}">{{statusText}}</view>
      <text class="subtitle" wx:if="{{status && status.step}}">{{status.step}}</text>
    </view>

    <view class="cell" wx:if="{{current}}">
      <view class="cell-label">当前版本</view>
      <view class="cell-value">{{current.commit || '未知提交'}}</view>
    </view>
    <view class="cell" wx:if="{{status}}">
      <view class="cell-label">上次部署</view>
      <view class="cell-value">{{status.message || '—'}}</view>
    </view>

    <button class="btn-primary deploy-btn" bindtap="onDeploy" disabled="{{busy}}">
      {{busy ? '部 署 中…' : '部 署 最 新 代 码'}}
    </button>
  </view>

  <view class="card">
    <view class="section-title">部署日志</view>
    <scroll-view class="deploy-log" scroll-y>
      <text>{{log || '暂无日志'}}</text>
    </scroll-view>
  </view>
</view>
