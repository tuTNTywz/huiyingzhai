.deploy-page {
  padding: 24rpx;
}

.deploy-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.deploy-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eee7da;
  color: #6f675d;
  font-size: 24rpx;
}
.deploy-badge.running { background: #fef3c7; color: #92400e; }
.deploy-badge.success { background: #dcfce7; color: #166534; }
.deploy-badge.failed { background: #fee2e2; color: #991b1b; }

.deploy-btn {
  margin-top: 24rpx;
}

.deploy-log {
  max-height: 520rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #faf7f1;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6f675d;
  white-space: pre-wrap;
  word-break: break-all;
}
