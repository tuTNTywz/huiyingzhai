<view class="card" wx:if="{{activity}}">
  <view class="detail-title">{{activity.title}}</view>
  <view class="detail-meta">
    <text class="tag {{ended ? 'tag-gray' : 'tag-green'}}">{{ended ? '已结束' : '招募中'}}</text>
    <text class="subtitle">发布于 {{activity.createTimeText}}</text>
  </view>

  <view class="divider"></view>

  <view class="info-row"><text class="info-label">时　间</text><text>{{activity.timeText}}</text></view>
  <view class="info-row"><text class="info-label">地　点</text><text>{{activity.place}}</text></view>
  <view class="info-row" wx:if="{{activity.organizer}}"><text class="info-label">组　织</text><text>{{activity.organizer}}</text></view>
  <view class="info-row" wx:if="{{activity.quota}}"><text class="info-label">名　额</text><text>{{activity.quota}}</text></view>
  <view class="info-row" wx:if="{{activity.contact}}" bindtap="copyContact">
    <text class="info-label">联　系</text><text class="copy-value">{{activity.contact}}（点击复制）</text>
  </view>
  <view class="info-row"><text class="info-label">发布人</text><text>{{activity.creatorName}}（班委）</text></view>

  <view class="divider"></view>
  <view class="section-title">活动说明</view>
  <view class="detail-desc">{{activity.content || '（暂无详细说明）'}}</view>

  <button wx:if="{{signupUrl}}" class="btn-plain signup-btn" bindtap="copySignup">复制报名链接</button>
  <button wx:if="{{isCommittee}}" class="btn-plain del-btn" bindtap="onDelete">删除志愿活动</button>
</view>
