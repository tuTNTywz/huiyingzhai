<view class="page-header">
  <view class="page-title">我的</view>
  <view class="page-sub">「 温故而知新 」</view>
</view>

<!-- 个人信息 -->
<view class="card">
  <view class="section-title">个人信息</view>
  <view class="profile-top" wx:if="{{user}}">
    <view class="avatar">{{initial}}</view>
    <view class="profile-name">
      <view class="name">{{user.name || '未登记'}}</view>
      <view class="profile-tags">
        <text class="tag {{isAdmin ? 'tag-red' : isCommittee ? 'tag-gold' : 'tag-green'}}">{{isAdmin ? '管理员' : isCommittee ? '班委' : '普通同学'}}</text>
        <text class="tag {{registered ? 'tag-gold' : 'tag-red'}}">{{registered ? '已登记' : '未登记'}}</text>
      </view>
    </view>
  </view>

  <view class="divider"></view>

  <view class="cell"><view class="cell-label">姓　名</view><view class="cell-value">{{user.name || '—'}}</view></view>
  <view class="cell"><view class="cell-label">学　号</view><view class="cell-value">{{user.studentId || '—'}}</view></view>
  <view class="cell"><view class="cell-label">班　级</view><view class="cell-value">{{user.className || '—'}}</view></view>
  <view class="cell"><view class="cell-label">职　位</view><view class="cell-value">{{user.position || '—'}}</view></view>
  <view class="cell"><view class="cell-label">身　份</view><view class="cell-value">{{isAdmin ? '管理员' : isCommittee ? '班委' : '普通同学'}}</view></view>
  <view class="cell"><view class="cell-label">负责科目</view><view class="cell-value">{{subjectDisplayName}}</view></view>

  <button class="btn-primary edit-btn" bindtap="openRegister">{{registered ? '登记 / 修改资料' : '立即登记'}}</button>
</view>

<view class="card tip-card">
  <view class="section-title">说明</view>
  <view class="tip-text">· 首次登录只需登记姓名与学号，班级和职位自动填好\n· 也可随时在此处打开登记窗口修改个人信息\n· 班委可发布作业与活动，宣传委员可发布志愿活动，管理员拥有全部权限并负责课程设置\n· 各学科课代表由班级名单（roster 集合）指定\n· 学号与微信账号一一对应，请勿冒用他人学籍</view>
</view>

<!-- 注册窗口 -->
<view class="modal-mask" wx:if="{{showModal}}" bindtap="closeRegister">
  <view class="modal-card" catchtap="noop">
    <view class="modal-seal">斋</view>
    <view class="modal-title">{{registered ? '修改资料' : '入斋登记'}}</view>
    <view class="modal-sub">「 请填学籍，以入同窗之列 」</view>

    <view class="form-item">
      <view class="form-label">姓名</view>
      <input class="form-input" placeholder="填写真实姓名" value="{{form.name}}" data-field="name" bindinput="onField" maxlength="20" />
    </view>

    <view class="form-item">
      <view class="form-label">学号</view>
      <input class="form-input" placeholder="填写学号" value="{{form.studentId}}" data-field="studentId" bindinput="onField" maxlength="30" />
    </view>

    <view class="form-item">
      <view class="form-label">班级</view>
      <view class="picker-value">{{form.className}}</view>
    </view>

    <view class="form-item">
      <view class="form-label">职位</view>
      <view class="picker-value {{form.position ? '' : 'picker-placeholder'}}">{{form.position || '填写学号后自动匹配'}}</view>
      <view class="position-tip">职位由学号自动匹配班级名单；班委可发布作业与活动，宣传委员可发布志愿活动，课代表由名单指定</view>
    </view>

    <view class="modal-actions">
      <button wx:if="{{registered}}" class="btn-plain" bindtap="closeRegister">取 消</button>
      <button class="{{submitting ? 'btn-disabled' : 'btn-primary'}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '提交中…' : submitText}}</button>
    </view>
  </view>
</view>
