<navigation-bar title="作业" back="{{true}}" color="#1A1A1A" background="#FFFFFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">

    <!-- 概览 -->
    <view class="summary">
      <view class="summary__left">
        <view class="summary__label">待提交作业</view>
        <view class="summary__value">
          <text class="summary__num">{{stats.pending}}</text>
          <text class="summary__unit">份</text>
        </view>
      </view>
      <view class="summary__right">
        <view class="summary__row">
          <text class="summary__row-label">已提交</text>
          <text class="summary__row-value">{{stats.done}}</text>
        </view>
        <view class="summary__row">
          <text class="summary__row-label">已逾期</text>
          <text class="summary__row-value summary__row-value--warn">{{stats.overdue}}</text>
        </view>
      </view>
    </view>

    <!-- 完成进度 -->
    <view class="progress">
      <view class="progress__head">
        <text class="progress__title">完成进度</text>
        <text class="progress__ratio">{{stats.done}}/{{stats.total}} · {{stats.percent}}%</text>
      </view>
      <view class="progress__track">
        <view class="progress__bar" style="width: {{stats.percent}}%"></view>
      </view>
    </view>

    <!-- 筛选 -->
    <view class="tabs">
      <view
        class="tab {{activeTab === item.key ? 'tab--active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTabChange"
        hover-class="press"
      >
        <text>{{item.label}}</text>
        <text
          class="tab__count {{activeTab === item.key ? 'tab__count--active' : ''}}"
          wx:if="{{item.count}}"
        >{{item.count}}</text>
      </view>
    </view>

    <!-- 作业列表 -->
    <view
      class="hw {{item.done ? 'hw--done' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onToggleDetail"
      hover-class="press"
    >
      <view class="hw__head">
        <view class="hw__title">{{item.title}}</view>
        <text class="status status--{{item.statusKey}}">{{item.statusText}}</text>
      </view>
      <view class="hw__meta">
        <text class="hw__course">{{item.course}}</text>
        <text class="hw__sep">·</text>
        <text class="hw__teacher">{{item.teacher}}</text>
        <text class="hw__badge" wx:if="{{item.published}}">我发布的</text>
      </view>
      <view class="hw__desc {{item.expanded ? 'hw__desc--open' : ''}}">{{item.desc}}</view>
      <view class="hw__file" wx:if="{{item.attachment}}">
        <view class="hw__file-icon">附</view>
        <text class="hw__file-name">{{item.attachment}}</text>
      </view>
      <view class="hw__footer">
        <view class="hw__due">
          <text class="hw__due-label">截止</text>
          <text class="hw__due-value">{{item.dueText}}</text>
        </view>
        <view class="hw__actions">
          <view
            class="hw__action hw__action--ghost hw__action--withdraw"
            wx:if="{{item.published}}"
            data-id="{{item.id}}"
            catchtap="onWithdraw"
            hover-class="press"
          >撤回</view>
          <view
            class="hw__action hw__action--primary"
            wx:if="{{!item.done}}"
            data-id="{{item.id}}"
            catchtap="onSubmit"
            hover-class="press"
          >去提交</view>
          <view
            class="hw__action hw__action--ghost"
            wx:else
            data-id="{{item.id}}"
            catchtap="onUndo"
            hover-class="press"
          >撤销提交</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{!list.length}}">
      <view class="empty__icon"></view>
      <view class="empty__title">这里空空如也</view>
      <view class="empty__desc">该分类下暂无作业</view>
    </view>

    <view class="footer" wx:if="{{list.length}}">— 已经到底啦 —</view>
  </view>
</scroll-view>

<!-- 课代表上传作业入口 -->
<view class="fab" wx:if="{{isRep}}" bindtap="onPublish" hover-class="press">
  <view class="fab__plus">
    <view class="fab__plus-h"></view>
    <view class="fab__plus-v"></view>
  </view>
  <text class="fab__text">上传作业</text>
</view>
