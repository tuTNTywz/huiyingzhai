page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F4F6FA;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.press {
  opacity: 0.7;
}

/* 概览 */
.summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #4A7DFF 0%, #6C5CE7 100%);
  box-shadow: 0 12rpx 32rpx rgba(74, 125, 255, 0.24);
}

.summary__left {
  display: flex;
  flex-direction: column;
}

.summary__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.summary__value {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  margin-top: 8rpx;
}

.summary__num {
  font-size: 60rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 64rpx;
}

.summary__unit {
  margin-left: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.summary__right {
  display: flex;
  flex-direction: column;
}

.summary__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 200rpx;
  padding: 8rpx 0;
}

.summary__row-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.74);
}

.summary__row-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.summary__row-value--warn {
  color: #FFD9A0;
}

/* 进度 */
.progress {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(23, 43, 77, 0.05);
}

.progress__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.progress__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.progress__ratio {
  font-size: 23rpx;
  color: #8A94A6;
}

.progress__track {
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #EDF0F6;
  overflow: hidden;
}

.progress__bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4A7DFF 0%, #6C5CE7 100%);
}

/* 筛选 */
.tabs {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(23, 43, 77, 0.05);
}

.tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #6B7484;
}

.tab--active {
  background: #3B6EF6;
  color: #FFFFFF;
  font-weight: 600;
}

.tab__count {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #A6AFBF;
}

.tab__count--active {
  color: rgba(255, 255, 255, 0.82);
}

/* 作业卡片 */
.hw {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(23, 43, 77, 0.05);
}

.hw--done .hw__title {
  color: #6B7484;
}

.hw__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.hw__title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 42rpx;
}

.status {
  flex: none;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #7A8496;
  background: #F1F4FA;
}

.status--urgent {
  color: #DE8613;
  background: #FFF2E0;
}

.status--overdue {
  color: #E0526A;
  background: #FDECEC;
}

.status--done {
  color: #22A06B;
  background: #E9F8F1;
}

.hw__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
}

.hw__course {
  font-size: 23rpx;
  color: #3B6EF6;
}

.hw__sep {
  margin: 0 8rpx;
  font-size: 23rpx;
  color: #C3C9D4;
}

.hw__teacher {
  font-size: 23rpx;
  color: #8A94A6;
}

.hw__badge {
  margin-left: auto;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  color: #6C5CE7;
  background: #F1EDFF;
}

.hw__desc {
  margin-top: 16rpx;
  max-height: 76rpx;
  overflow: hidden;
  font-size: 25rpx;
  line-height: 38rpx;
  color: #5A6474;
}

.hw__desc--open {
  max-height: 2000rpx;
}

.hw__file {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #F5F7FB;
}

.hw__file-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #FFFFFF;
  background: #8FA5D8;
}

.hw__file-name {
  flex: 1;
  font-size: 23rpx;
  color: #5A6474;
}

.hw__footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F2F4F8;
}

.hw__due {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hw__due-label {
  font-size: 22rpx;
  color: #A6AFBF;
}

.hw__due-value {
  margin-left: 8rpx;
  font-size: 23rpx;
  color: #4A5261;
}

.hw__actions {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hw__action {
  flex: none;
  height: 56rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
}

.hw__action--withdraw {
  margin-right: 16rpx;
}

.hw__action--primary {
  color: #FFFFFF;
  background: #3B6EF6;
}

.hw__action--ghost {
  color: #7A8496;
  border: 2rpx solid #E3E8F0;
}

/* 空状态 */
.empty {
  padding: 120rpx 0 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty__icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx dashed #D8DEE9;
  box-sizing: border-box;
}

.empty__title {
  margin-top: 24rpx;
  font-size: 27rpx;
  color: #6B7484;
}

.empty__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #A6AFBF;
}

.footer {
  padding: 36rpx 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B3BBC9;
}

/* 上传作业入口 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  height: 88rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #3B6EF6;
  box-shadow: 0 12rpx 28rpx rgba(59, 110, 246, 0.32);
}

.fab__plus {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.fab__plus-h {
  position: absolute;
  top: 12rpx;
  left: 0;
  width: 28rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
}

.fab__plus-v {
  position: absolute;
  top: 0;
  left: 12rpx;
  width: 4rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
}

.fab__text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}
