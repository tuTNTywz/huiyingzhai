<!--index.wxml-->
<navigation-bar title="首页" back="{{false}}" color="#1A1A1A" background="#FFFFFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">

    <!-- 问候区 -->
    <view class="hero">
      <view class="hero__top">
        <view class="hero__text">
          <view class="hero__greeting">{{greeting}}，同学</view>
          <view class="hero__date">{{dateText}}</view>
        </view>
        <view class="hero__avatar">A3</view>
      </view>
      <view class="hero__stats">
        <view
          class="stat {{index > 0 ? 'stat--divider' : ''}}"
          wx:for="{{stats}}"
          wx:key="label"
          data-label="{{item.label}}"
          bindtap="onStatTap"
          hover-class="press"
        >
          <view class="stat__value">{{item.value}}</view>
          <view class="stat__label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <!-- 搜索 -->
    <view class="search" bindtap="onSearchTap" hover-class="press">
      <view class="search__icon">
        <view class="search__icon-handle"></view>
      </view>
      <text class="search__placeholder">搜索课程、公告、同学</text>
    </view>

    <!-- 快捷入口 -->
    <view class="card">
      <view class="card__head">
        <text class="card__title">快捷入口</text>
        <text class="card__more" data-target="快捷入口" bindtap="onMoreTap">管理</text>
      </view>
      <view class="grid">
        <view
          class="grid__item"
          wx:for="{{quickEntries}}"
          wx:key="id"
          data-name="{{item.name}}"
          bindtap="onQuickTap"
          hover-class="press"
        >
          <view class="grid__icon" style="background: {{item.bg}}; color: {{item.color}}">{{item.icon}}</view>
          <text class="grid__label">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 今日课程 -->
    <view class="card">
      <view class="card__head">
        <text class="card__title">今日课程</text>
        <text class="card__more" data-target="课程表" bindtap="onMoreTap">全部</text>
      </view>
      <view
        class="course"
        wx:for="{{courses}}"
        wx:key="id"
        data-name="{{item.name}}"
        bindtap="onCourseTap"
        hover-class="press"
      >
        <view class="course__time">
          <text class="course__start">{{item.start}}</text>
          <text class="course__end">{{item.end}}</text>
        </view>
        <view class="course__line">
          <view class="course__dot" style="background: {{item.dot}}"></view>
          <view class="course__rail" wx:if="{{index < courses.length - 1}}"></view>
        </view>
        <view class="course__body">
          <view class="course__top">
            <text class="course__name">{{item.name}}</text>
            <text class="tag {{item.live ? 'tag--live' : ''}}">{{item.status}}</text>
          </view>
          <text class="course__meta">{{item.room}} · {{item.teacher}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{!courses.length}}">今天没有课程安排</view>
    </view>

    <!-- 班级公告 -->
    <view class="card">
      <view class="card__head">
        <text class="card__title">班级公告</text>
        <text class="card__more" data-target="公告列表" bindtap="onMoreTap">更多</text>
      </view>
      <view
        class="notice"
        wx:for="{{notices}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onNoticeTap"
        hover-class="press"
      >
        <view class="notice__dot {{item.unread ? '' : 'notice__dot--hidden'}}"></view>
        <view class="notice__body">
          <view class="notice__title {{item.unread ? 'notice__title--unread' : ''}}">{{item.title}}</view>
          <view class="notice__meta">{{item.tag}} · {{item.time}}</view>
        </view>
      </view>
    </view>

    <view class="footer">— 已经到底啦 —</view>
  </view>
</scroll-view>
