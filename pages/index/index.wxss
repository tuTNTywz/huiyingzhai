/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F4F6FA;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.press {
  opacity: 0.7;
}

/* 问候区 */
.hero {
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #4A7DFF 0%, #6C5CE7 100%);
  box-shadow: 0 12rpx 32rpx rgba(74, 125, 255, 0.24);
}

.hero__top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.hero__text {
  display: flex;
  flex-direction: column;
}

.hero__greeting {
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.hero__date {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero__avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
}

.hero__stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 36rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat--divider {
  border-left: 2rpx solid rgba(255, 255, 255, 0.18);
}

.stat__value {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.stat__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* 搜索 */
.search {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(23, 43, 77, 0.06);
}

.search__icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  margin-right: 18rpx;
  border: 3rpx solid #A6AFBF;
  border-radius: 50%;
  box-sizing: border-box;
}

.search__icon-handle {
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 12rpx;
  height: 3rpx;
  background: #A6AFBF;
  transform: rotate(45deg);
}

.search__placeholder {
  font-size: 26rpx;
  color: #A6AFBF;
}

/* 通用卡片 */
.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(23, 43, 77, 0.05);
}

.card__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.card__more {
  font-size: 24rpx;
  color: #8A94A6;
  padding: 8rpx 4rpx 8rpx 16rpx;
}

/* 快捷入口 */
.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding-top: 12rpx;
}

.grid__item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.grid__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.grid__label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4A5261;
}

/* 今日课程 */
.course {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding-top: 20rpx;
}

.course__time {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-top: 4rpx;
}

.course__start {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.course__end {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A6AFBF;
}

.course__line {
  width: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
}

.course__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.course__rail {
  width: 2rpx;
  flex: 1;
  margin-top: 8rpx;
  background: #EDF0F6;
}

.course__body {
  flex: 1;
  padding-bottom: 26rpx;
  display: flex;
  flex-direction: column;
}

.course__top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.course__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.course__meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8A94A6;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #7A8496;
  background: #F1F4FA;
}

.tag--live {
  color: #3B6EF6;
  background: #EAF1FF;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #A6AFBF;
}

/* 班级公告 */
.notice {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 0;
}

.notice__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #F5544A;
  margin: 14rpx 14rpx 0 0;
}

.notice__dot--hidden {
  background: transparent;
}

.notice__body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.notice__title {
  font-size: 27rpx;
  color: #4A5261;
  line-height: 38rpx;
}

.notice__title--unread {
  font-weight: 600;
  color: #1A1A1A;
}

.notice__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A6AFBF;
}

/* 底部 */
.footer {
  padding: 36rpx 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B3BBC9;
}
