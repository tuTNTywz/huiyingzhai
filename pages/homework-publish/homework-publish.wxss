page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F4F6FA;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.press {
  opacity: 0.7;
}

/* 提示条 */
.tip {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #EAF1FF;
}

.tip__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #3B6EF6;
  flex: none;
}

.tip__text {
  flex: 1;
  font-size: 23rpx;
  line-height: 34rpx;
  color: #3B5FA8;
}

/* 表单 */
.card {
  margin-top: 24rpx;
  padding: 4rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(23, 43, 77, 0.05);
}

.field {
  padding: 26rpx 0;
  border-bottom: 2rpx solid #F2F4F8;
}

.field--last {
  border-bottom: 0;
}

.field__label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #8A94A6;
}

.field__star {
  margin-left: 6rpx;
  color: #F5544A;
}

.field__input {
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #F7F9FC;
  font-size: 27rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.field__placeholder {
  color: #A6AFBF;
  font-size: 26rpx;
}

.field__picker {
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #F7F9FC;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.field__picker--compact {
  flex: 1;
}

.field__value {
  font-size: 27rpx;
  color: #1A1A1A;
}

.field__chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #A6AFBF;
  border-bottom: 3rpx solid #A6AFBF;
  transform: rotate(45deg);
}

.field__row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.field__row-item {
  flex: 1;
}

.field__row-item--right {
  margin-left: 20rpx;
}

.field__textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F7F9FC;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.field__count {
  display: block;
  margin-top: 10rpx;
  text-align: right;
  font-size: 21rpx;
  color: #A6AFBF;
}

/* 附件 */
.file {
  height: 132rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #D8DEE9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.file__plus {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.file__plus-h {
  position: absolute;
  top: 14rpx;
  left: 0;
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #8A94A6;
}

.file__plus-v {
  position: absolute;
  top: 0;
  left: 14rpx;
  width: 4rpx;
  height: 32rpx;
  border-radius: 2rpx;
  background: #8A94A6;
}

.file__hint {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8A94A6;
}

.file-selected {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #F5F7FB;
}

.file-selected__icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  background: #8FA5D8;
  flex: none;
}

.file-selected__body {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.file-selected__name {
  font-size: 25rpx;
  color: #1A1A1A;
}

.file-selected__size {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #A6AFBF;
}

.file-selected__remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #A6AFBF;
}

.footer-note {
  margin-top: 24rpx;
  padding: 0 8rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 32rpx;
  color: #A6AFBF;
}

/* 底部按钮 */
.submit-bar {
  flex: none;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid #F2F4F8;
}

.submit-btn {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #3B6EF6;
}

.submit-btn--disabled {
  background: #BFD0F7;
}
